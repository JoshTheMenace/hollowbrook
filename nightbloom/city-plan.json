{
  "city": {
    "name": "宵坂 (Yoizaka)",
    "promise": "A worked-in Japanese branch-line town at golden hour in early autumn, dry and still, where the visitor who walks from the level crossing to the festival ground discovers that every lantern, charm and swept surface the town owns is aimed at the field where night blooms.",
    "footprint_m": [
      130,
      100
    ],
    "palette_notes": "Value ladder: indigo-grey roof tile (dark) -> aged cedar and plaster walls (mid) -> paper and sand paving (light). Shade is violet-tinted, never black. Two saturated accents only: paper-lantern amber, owned by shopfronts and the festival ground; spirit-blossom pink, owned by the shrine and by blossom/charms everywhere — nothing else may use either.",
    "compass": {
      "north_xz": [
        0,
        -1
      ]
    },
    "sun": {
      "bearing": "south-west",
      "elevation_deg": 14
    }
  },
  "shared_kit": {
    "module": "src/kit/",
    "builders_required": [
      "machiya — the gabled timber shopfront: fascia board, sliding door bay, first-floor rail, optional noren; parameterized width/depth/tenant",
      "rowhouse — modest tiled dwelling with genkan step, for lanes; 2-3 seeded variants",
      "shrineHall — small hall with hip-gable roof, offering box, bell rope",
      "torii — vermilion-free WOODEN torii (weathered cedar, pink charm tags), heights 4-6 m",
      "yagura — the festival drum tower: square timber frame, red-white bunting skirt, ladder, drum platform",
      "matsuriStall — festival stall: counter, awning, hanging goods; closed/shuttered variant",
      "stationHalt — single low platform, shelter hut, name board, fence run",
      "crossingSignal — level-crossing mast: lights, bell, half barrier",
      "stoneLantern — toro in 2 sizes, mossy base",
      "lanternString — catenary string of paper lanterns between two anchor points, amber emissive",
      "canalKerb — stone channel kerb run with inset steps and water plane between",
      "footbridge — timber footbridge over the canal with handrails",
      "phonebox — one glazed public phone box (quest prop)",
      "postRack — bicycle rack / parked bicycles cluster"
    ],
    "signage_tenants": [
      "宵坂駅 (the halt name board)",
      "蕎麦 よいざか (soba shop)",
      "駄菓子 ほしや (dagashi sweets)",
      "金物 たけだ (hardware)",
      "花 このは (florist)",
      "米屋 いなほ (rice merchant)",
      "喫茶 月見 (kissaten)",
      "薬局 くすのき (pharmacy)",
      "宵坂神社 (shrine name plate + ema tags)",
      "宵祭 (festival banners and nobori)",
      "夜間立入注意 (night-warning notice, town's one visible admission)"
    ]
  },
